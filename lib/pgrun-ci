verify_main() {
  v_fail_on="${PGRUN_IN_VERIFY_FAIL_ON:-critical}"
  v_block_on="${PGRUN_IN_VERIFY_BLOCK_ON:-$VERIFY_DEFAULT_BLOCK_ON}"; v_block_on="${v_block_on// /}"
  local compare="${PGRUN_IN_VERIFY_COMPARE_PGX:-true}"
  [ -n "${PGRUN_API_TOKEN:-}" ] || verify_refuse "no PGRun token: the \`token\` input is empty. A pull request from a fork gets no secrets — run PGRun CI only for branches of this repository, and store the token as the PGRUN_API_TOKEN secret."
  [ "${GITHUB_EVENT_NAME:-}" = pull_request_target ] && verify_refuse "refusing to run on pull_request_target: it would hand PR code the PGRun token. Use pull_request."
  # Verification runs the migration on a branch of the sanitized Safe Copy.
  if [ "${PGRUN_IN_ALLOW_PUBLIC_REPOSITORY:-false}" != true ] && [ -f "${GITHUB_EVENT_PATH:-}" ] \
     && [ "$(jq -r '.repository.private | if . == false then "false" else "" end' "$GITHUB_EVENT_PATH")" = false ]; then
    verify_refuse "this repository is public: anyone can read its Actions logs, and verification runs your migration on a branch of the sanitized copy. Use a private repository, or set allow-public-repository: true to accept this."
  fi
  case "$v_fail_on" in critical|warning|none) ;; *) verify_refuse "verify-fail-on must be critical, warning or none (got: $v_fail_on)" ;; esac
  if [ "$v_block_on" != none ]; then
    local c; for c in ${v_block_on//,/ }; do
      [[ " $VERIFY_CATEGORIES " == *" $c "* ]] || verify_refuse "verify-block-on: unknown category $c (use a comma list of: ${VERIFY_CATEGORIES// /, }; or none)"
    done
  fi
  case "$compare" in true|false) ;; *) verify_refuse "verify-compare-pgx must be true or false" ;; esac
  [[ "$ready_timeout" =~ ^[0-9]+$ ]] || verify_refuse "ready-timeout must be a number of seconds"
  command -v jq > /dev/null || verify_refuse "jq is required (preinstalled on GitHub-hosted runners)"

  v_dir=$(mktemp -d "$runtime/verify.XXXXXX"); chmod 700 "$v_dir"
  v_report="$v_dir/report.json"
  cd "$workdir"
  framework=$(cat "$runtime/framework" 2>/dev/null || echo none)
  [ "$framework_in" != auto ] && framework="$framework_in"
  local cmd="${PGRUN_IN_VERIFY_COMMAND:-}"; [ -n "$cmd" ] || cmd=$(migrate_cmd)
  [ -n "$cmd" ] || verify_refuse "no migration command to verify: set verify-command (or migrate-command)."
  # A missing bundle would read as a failed migration: say what it is instead.
  if [ "$framework" = rails ] && ! { command -v bundle > /dev/null && bundle check > /dev/null 2>&1; }; then
    verify_refuse "the bundle is not installed. Keep setup-ruby: true (default), or run bundle install before this step."
  fi

  local why rc=0
  if ! verify_cli; then
    verify_synth "$(cat "$v_dir/why")"
  else
    local args=(bot verify)
    [ -n "$project_in" ] && args+=("$project_in")
    args+=(--json --fail-on "$v_fail_on" --block-on "$v_block_on" --ttl "$ttl" --timeout "${ready_timeout}s")
    [ "$compare" = true ] && args+=(--compare-pgx)
    # The migration gets DATABASE_URL from pgrun, never the PGRun token.
    args+=(-- env -u PGRUN_API_TOKEN RAILS_ENV="$rails_env" bash -c "$cmd")
    log "verifying the migration: $cmd (fail-on $v_fail_on, block-on $v_block_on$([ "$compare" = true ] && echo ', compared on PGX'))"
    trap verify_on_signal INT TERM
    bg pgrun "${args[@]}" > "$v_dir/stdout" 2> "$v_dir/stderr" || rc=$?
    trap - INT TERM
    # Migration output is the customer's: no workflow command in it may run.
    local stop; stop=$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')
    echo "::group::pgrun bot verify output (exit $rc)"; echo "::stop-commands::$stop"
    redact < "$v_dir/stderr"; echo "::$stop::"; echo "::endgroup::"
    if jq -s -e 'length == 1 and (.[0] | type == "object" and .kind == "pgrun-verify"
          and ((.version // "") | startswith("1.")) and (.verdict | type == "string")
          and (.blocking | type == "boolean") and (.categories | type == "array"))' "$v_dir/stdout" > /dev/null 2>&1; then
      # The report is kept for later steps: no URL in it, even from an error message.
      jq 'walk(if type == "string" then gsub("postgres(ql)?://[^\\s\"]+"; "<url>") else . end)' "$v_dir/stdout" > "$v_report"
      local blocking; blocking=$(jq -r '.blocking' "$v_report")
      if { [ "$blocking" = true ] && [ "$rc" = 0 ]; } || { [ "$blocking" = false ] && [ "$rc" != 0 ]; }; then
        echo "::warning title=PGRun verify::pgrun exited $rc but its report says blocking=$blocking; the report decides"
      fi
    else
      local tail_err; tail_err=$(redact < "$v_dir/stderr" | grep -v '^[[:space:]]*$' | tail -1 | cut -c1-300)
      case "$rc" in
        2)   why="pgrun is not authenticated or not configured (exit 2)${tail_err:+: $tail_err}" ;;
        64)  why="pgrun rejected the verify arguments (exit 64) — the CLI may be too old for pgrun-verify 1.1${tail_err:+: $tail_err}" ;;
        127) why="pgrun could not be started (exit 127)" ;;
        *)   why="pgrun exited $rc without a pgrun-verify 1.x JSON report${tail_err:+: $tail_err}" ;;
      esac
      verify_synth "$why"
    fi
  fi
  rm -f "$v_dir/stdout"

  local verdict blocking cats
  verdict=$(jq -r '.verdict' "$v_report"); blocking=$(jq -r '.blocking' "$v_report")
  cats=$(jq -r '.categories | join(",")' "$v_report")
  { echo "verdict=$verdict"; echo "blocking=$blocking"; echo "categories=$cats"; echo "report=$v_report"; } >> "${GITHUB_OUTPUT:-/dev/null}"
  jq -r --arg fail_on "$v_fail_on" --arg ttl "$ttl" "$VERIFY_SUMMARY_JQ" "$v_report" | redact >> "$summary"
  jq -r --arg fail_on "$v_fail_on" "$VERIFY_ANNOTATE_JQ" "$v_report" | redact
  log "verification: $verdict (categories: ${cats:-none}; blocking: $blocking) — report $v_report"
  [ "$blocking" = true ] && exit 1
  exit 0
}

# --------------------------------------------------------------------- main
finish() {
  local code=$?
  trap - INT TERM EXIT
  if [ -n "$(get prefix)" ] && [ -z "$(get cleaned)" ]; then delete_prefix "$(get prefix)"; record cleaned 1; fi
  rm -f "$runtime"/url_*
  [ -z "$(get summary_written)" ] && { write_summary; record summary_written 1; }
  exit "$code"
}

on_signal() {
  trap '' INT TERM
  [ -n "$CHILD" ] && kill -TERM "$CHILD" 2>/dev/null
  pkill -TERM -P $$ 2>/dev/null || true
  echo "::warning title=PGRun CI::cancelled — deleting this run's branches"
  record result CANCELLED
  record error "the run was cancelled"
  exit 130   # → finish
}

main_run() {
  : > "$state"
  export PGRUN_ACTION_DIR="$ACTION_DIR"
  [ -n "${PGRUN_API_TOKEN:-}" ] || die "no PGRun token: the \`token\` input is empty. A pull request from a fork gets no secrets — run PGRun CI only for branches of this repository (see the README's \`if:\`), and store the token as the PGRUN_API_TOKEN secret."
  if [ "${GITHUB_EVENT_NAME:-}" = pull_request_target ]; then
    die "refusing to run on pull_request_target: it would hand PR code the PGRun token. Use pull_request."
  fi
  case "$mode" in production-like|fast) ;; *) die "mode must be production-like or fast (got: $mode)" ;; esac
  if [ "$mode" = production-like ] && [ "${PGRUN_IN_ALLOW_PUBLIC_REPOSITORY:-false}" != true ] \
     && [ -f "${GITHUB_EVENT_PATH:-}" ] && [ "$(jq -r '.repository.private | if . == false then "false" else "" end' "$GITHUB_EVENT_PATH")" = false ]; then
    # (jq's `// empty` turns false into empty, so `.repository.private // empty` never matched.)
    die "this repository is public: anyone can read its Actions logs, and production-like mode runs your migrations and tests on the sanitized copy, which they could print. Use a private repository, or set allow-public-repository: true to accept this."
  fi
  case "$engine" in pgx|postgres|any) ;; *) die "engine must be pgx, postgres or any" ;; esac
  trap on_signal INT TERM
  trap finish EXIT
  cd "$workdir"
  framework=$(cat "$runtime/framework" 2>/dev/null || echo none)
  [ "$framework_in" != auto ] && framework="$framework_in"
  [ "$framework" = rails ] && rails_preflight
  command -v jq > /dev/null || die "jq is required (preinstalled on GitHub-hosted runners)"
  need_psql
  timed cli install_cli
  timed context resolve_context
  check_gates
  if [ "$mode" = fast ]; then fast; else production_like; fi
}

case "${1:-}" in
  detect) detect ;;
  run) main_run ;;
  cleanup)
    # Backstop for a run step that was killed before its own exit handler ran.
    p=$(get prefix)
    if [ -n "$p" ] && [ -z "$(get cleaned)" ] && command -v pgrun > /dev/null; then
      PGRUN_PROJECT=$(get project); export PGRUN_PROJECT
      delete_prefix "$p"; record cleaned 1
    fi
    rm -f "$runtime"/url_*
    [ -z "$(get summary_written)" ] && { [ -n "$(get result)" ] || record result CANCELLED; write_summary; record summary_written 1; }
    exit 0 ;;
  verify) verify_main ;;
  *) echo "usage: pgrun-ci detect|run|verify|cleanup" >&2; exit 64 ;;
esac
